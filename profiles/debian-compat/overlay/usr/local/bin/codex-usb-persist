#!/bin/bash
# codex-usb-persist — Manage USB persistence (LUS) partition
# Part of CoLinux Lite
#
# Manages the LUKS-encrypted persistence partition on a CoLinux USB drive.
#
# Usage: codex-usb-persist <COMMAND> [OPTIONS]
#   status                  Show persistence partition status
#   open [DEVICE]           Open/unlock LUKS persistence
#   close                   Close/lock LUKS persistence
#   mount [DEVICE]          Open and mount persistence at /persist
#   unmount                 Unmount and close persistence
#   resize [DEVICE] SIZE    Resize persistence filesystem
#   passphrase [DEVICE]     Change LUKS passphrase
#   info [DEVICE]           Detailed info about persistence partition
set -euo pipefail


COLINUX_COMMAND="codex-usb-persist"
[[ " $* " == *" --json "* ]] && COLINUX_JSON=true
[[ " $* " == *" --yes "* || " $* " == *" -y "* ]] && COLINUX_YES=true
# shellcheck source=/usr/local/lib/colinux/output.sh
if ! source /usr/local/lib/colinux/output.sh 2>/dev/null; then
    colinux_init_output() { :; }
    colinux_result() { :; }
    colinux_die() { echo "ERROR: $*" >&2; exit 1; }
    colinux_confirm() {
        [[ "${COLINUX_YES:-}" == "true" ]] && return 0
        local _r=""; read -rp "$1 " _r || _r=""; case "${_r,,}" in y|yes) return 0;; *) return 1;; esac
    }
fi

PERSIST_DIR="/persist"
MOUNT_POINT="/persist"
LUKS_MAPPER="codex-persist"
LOG_DIR="/persist/logs"
LOGFILE="${LOG_DIR}/disk-actions.log"

# Best-effort: /persist/ may not exist yet (CI, pre-first-boot, read-only).
# Logging already degrades gracefully via `2>/dev/null || true` below.
mkdir -p "$LOG_DIR" 2>/dev/null || true

log_action() {
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S %Z')"
    { echo "[$ts] usb-persist: $*" >> "$LOGFILE"; } 2>/dev/null || true
}

die() {
    log_action "FATAL usb-persist: $*"
    colinux_die "$@"
}

# ── Find the persistence partition ────────────────────────────────────────
find_persist_part() {
    local specified="${1:-}"

    if [[ -n "$specified" ]]; then
        if [[ ! -b "$specified" ]]; then
            die "Not a block device: $specified"
        fi
        echo "$specified"
        return
    fi

    # Try by label
    local by_label
    by_label="$(blkid -t LABEL=codex-persist -o device 2>/dev/null | head -1 || true)"
    if [[ -n "$by_label" ]]; then
        echo "$by_label"
        return
    fi

    # Try by UUID from stored state
    if [[ -f "${PERSIST_DIR}/install-info" ]]; then
        local stored_uuid
        stored_uuid="$(grep persist_uuid "${PERSIST_DIR}/install-info" 2>/dev/null | cut -d= -f2 || true)"
        if [[ -n "$stored_uuid" ]]; then
            local by_uuid
            by_uuid="$(blkid -t UUID="$stored_uuid" -o device 2>/dev/null | head -1 || true)"
            if [[ -n "$by_uuid" ]]; then
                echo "$by_uuid"
                return
            fi
        fi
    fi

    # Try to find a LUKS partition with 'codex' in its label
    local luks_parts
    luks_parts="$(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null || true)"
    for part in $luks_parts; do
        local label
        label="$(blkid -s LABEL -o value "$part" 2>/dev/null || true)"
        if [[ "$label" == *"persist"* ]] || [[ "$label" == *"codex"* ]]; then
            echo "$part"
            return
        fi
    done

    echo ""
}

# ── Check if LUKS is open ─────────────────────────────────────────────────
is_luks_open() {
    [[ -e "/dev/mapper/${LUKS_MAPPER}" ]]
}

# ── Check if mounted ──────────────────────────────────────────────────────
is_mounted() {
    mountpoint -q "$MOUNT_POINT" 2>/dev/null
}

# ── Command: status ───────────────────────────────────────────────────────
cmd_status() {
    local device
    device="$(find_persist_part "${1:-}")"

    echo "=== USB Persistence Status ==="
    echo ""

    if is_mounted; then
        echo "State:      MOUNTED"
        local mount_info
        mount_info="$(findmnt -n -o SOURCE,TARGET,FSTYPE,OPTIONS "$MOUNT_POINT" 2>/dev/null || true)"
        echo "Details:    $mount_info"
        local usage
        usage="$(df -h "$MOUNT_POINT" 2>/dev/null | tail -1 || echo 'unknown')"
        echo "Usage:      $usage"
    elif is_luks_open; then
        echo "State:      UNLOCKED (not mounted)"
        echo "Mapper:     /dev/mapper/${LUKS_MAPPER}"
        local mapper_size
        mapper_size="$(lsblk -d -n -o SIZE "/dev/mapper/${LUKS_MAPPER}" 2>/dev/null || echo 'unknown')"
        echo "Size:       $mapper_size"
    else
        echo "State:      LOCKED"
    fi

    echo ""

    if [[ -n "$device" ]]; then
        echo "Partition:  $device"
        local part_size
        part_size="$(lsblk -d -n -o SIZE "$device" 2>/dev/null || echo 'unknown')"
        local part_uuid
        part_uuid="$(blkid -s UUID -o value "$device" 2>/dev/null || echo 'N/A')"
        local part_label
        part_label="$(blkid -s LABEL -o value "$device" 2>/dev/null || echo 'N/A')"
        echo "Size:       $part_size"
        echo "UUID:       $part_uuid"
        echo "Label:      $part_label"
        echo "Type:       $(blkid -s TYPE -o value "$device" 2>/dev/null || echo 'N/A')"
    else
        echo "Partition:  (not found)"
        echo "  Search by LABEL=codex-persist or specify device manually."
    fi

    # Show persistence directory contents
    if is_mounted; then
        echo ""
        echo "=== /persist contents ==="
        echo "  backups/:  $(du -sh "${PERSIST_DIR}/backups" 2>/dev/null | awk '{print $1}' || echo 'N/A')"
        echo "  logs/:     $(du -sh "${PERSIST_DIR}/logs" 2>/dev/null | awk '{print $1}' || echo 'N/A')"
        echo "  state/:    $(du -sh "${PERSIST_DIR}/state" 2>/dev/null | awk '{print $1}' || echo 'N/A')"
    fi
}

# ── Command: open ─────────────────────────────────────────────────────────
cmd_open() {
    local device
    device="$(find_persist_part "${1:-}")"

    if [[ -z "$device" ]]; then
        die "Persistence partition not found. Specify device: codex-usb-persist open /dev/sdX3"
    fi

    if is_luks_open; then
        echo "LUKS persistence already unlocked (/dev/mapper/${LUKS_MAPPER})."
        return 0
    fi

    echo "Opening LUKS persistence: $device"
    echo -n "Passphrase: "
    read -rs PASSPHRASE
    echo ""

    if [[ -z "$PASSPHRASE" ]]; then
        die "Passphrase required."
    fi

    if echo -n "$PASSPHRASE" | cryptsetup open "$device" "$LUKS_MAPPER" -; then
        echo "✓ Persistence unlocked."
        log_action "open_ok device=$device"
    else
        die "Failed to unlock. Wrong passphrase or device error."
    fi
    unset PASSPHRASE
}

# ── Command: close ────────────────────────────────────────────────────────
cmd_close() {
    if is_mounted; then
        echo "Unmounting persistence..."
        umount "$MOUNT_POINT" || die "Failed to unmount $MOUNT_POINT"
    fi

    if is_luks_open; then
        echo "Closing LUKS persistence..."
        cryptsetup close "$LUKS_MAPPER" || die "Failed to close LUKS mapper"
        echo "✓ Persistence closed."
        log_action "close_ok"
    else
        echo "Persistence is already closed."
    fi
}

# ── Command: mount ────────────────────────────────────────────────────────
cmd_mount() {
    if is_mounted; then
        echo "Persistence already mounted at $MOUNT_POINT"
        return 0
    fi

    if ! is_luks_open; then
        cmd_open "${1:-}"
    fi

    mkdir -p "$MOUNT_POINT"

    if mount "/dev/mapper/${LUKS_MAPPER}" "$MOUNT_POINT"; then
        echo "✓ Persistence mounted at $MOUNT_POINT"
        log_action "mount_ok mountpoint=$MOUNT_POINT"

        # Ensure subdirectories exist
        mkdir -p "${PERSIST_DIR}/"{logs,backups,state,workspace}
    else
        die "Failed to mount persistence."
    fi
}

# ── Command: unmount ──────────────────────────────────────────────────────
cmd_unmount() {
    if ! is_mounted; then
        echo "Persistence is not mounted."
        return 0
    fi

    echo "Unmounting persistence..."
    if umount "$MOUNT_POINT"; then
        echo "✓ Persistence unmounted."
        log_action "unmount_ok"
    else
        die "Failed to unmount. Check for open files: lsof $MOUNT_POINT"
    fi

    # Optionally close LUKS
    if is_luks_open; then
        echo "Closing LUKS mapper..."
        cryptsetup close "$LUKS_MAPPER" 2>/dev/null || true
        log_action "close_ok"
    fi
}

# ── Command: resize ───────────────────────────────────────────────────────
cmd_resize() {
    local device="$1"
    local new_size="$2"

    if [[ -z "$device" ]] || [[ -z "$new_size" ]]; then
        echo "Usage: codex-usb-persist resize /dev/sdX3 SIZE"
        echo "  SIZE can be: +500M, -1G, 8G, max"
        die "Device and size required."
    fi

    if [[ ! -b "$device" ]]; then
        die "Not a block device: $device"
    fi

    # We cannot resize a partition if LUKS is open and mounted
    if is_mounted; then
        die "Unmount persistence first: codex-usb-persist unmount"
    fi
    if is_luks_open; then
        die "Close LUKS first: codex-usb-persist close"
    fi

    echo "⚠ WARNING: Resizing partitions is potentially destructive."
    echo "  Device: $device"
    echo "  New size: $new_size"
    echo ""
    echo -n "Type RESIZE to confirm: "
    read -r confirm
    if [[ "$confirm" != "RESIZE" ]]; then
        echo "Aborted."
        return 0
    fi

    log_action "resize_start device=$device size=$new_size"

    # Resize partition using sgdisk
    if command -v sgdisk &>/dev/null; then
        local part_num
        # Extract partition number from device
        if [[ "$device" =~ ^/dev/(nvme[0-9]+n[0-9]+)p([0-9]+)$ ]]; then
            part_num="${BASH_REMATCH[2]}"
            local disk="/dev/${BASH_REMATCH[1]}"
        elif [[ "$device" =~ ^/dev/([a-z]+)([0-9]+)$ ]]; then
            part_num="${BASH_REMATCH[2]}"
            local disk="/dev/${BASH_REMATCH[1]}"
        else
            die "Cannot parse partition number from $device"
        fi

        if [[ "$new_size" == "max" ]]; then
            # Delete and recreate partition to fill remaining space
            echo "Resizing to maximum..."
            sgdisk -d "$part_num" "$disk" 2>/dev/null
            sgdisk -N "$part_num" "$disk" 2>/dev/null
            sgdisk -t "$part_num":8300 "$disk" 2>/dev/null
            sgdisk -c "$part_num":"CoLinux Persistence" "$disk" 2>/dev/null
        else
            echo "Note: Precise partition resizing with sgdisk requires careful calculation."
            echo "Consider using 'max' for automatic resize, or use a partitioning tool."
        fi

        partprobe "$device" 2>/dev/null || true
        sleep 2

        # Resize LUKS if the partition contains LUKS
        if blkid -s TYPE -o value "$device" 2>/dev/null | grep -qi luks; then
            echo "Opening LUKS to resize..."
            echo -n "Passphrase: "
            read -rs PASSPHRASE
            echo ""
            echo -n "$PASSPHRASE" | cryptsetup open "$device" "$LUKS_MAPPER" -
            cryptsetup resize "$LUKS_MAPPER" 2>/dev/null
            e2fsck -f -y "/dev/mapper/${LUKS_MAPPER}" 2>/dev/null
            resize2fs "/dev/mapper/${LUKS_MAPPER}" 2>/dev/null
            cryptsetup close "$LUKS_MAPPER"
            unset PASSPHRASE
            echo "✓ LUKS container and filesystem resized."
        fi

        log_action "resize_ok device=$device size=$new_size"
        echo "✓ Partition resized. Verify with: codex-usb-persist status $device"
    else
        die "sgdisk required for partition resize. Install: apt install gdisk"
    fi
}

# ── Command: passphrase ───────────────────────────────────────────────────
cmd_passphrase() {
    local device
    device="$(find_persist_part "${1:-}")"

    if [[ -z "$device" ]]; then
        die "Persistence partition not found."
    fi

    echo "Changing LUKS passphrase for: $device"
    echo ""
    echo -n "Current passphrase: "
    read -rs OLD_PASS
    echo ""
    echo -n "New passphrase: "
    read -rs NEW_PASS
    echo ""
    echo -n "Confirm new passphrase: "
    read -rs NEW_PASS_CONFIRM
    echo ""

    if [[ "$NEW_PASS" != "$NEW_PASS_CONFIRM" ]]; then
        die "New passphrases do not match."
    fi

    if echo -n "$OLD_PASS" | cryptsetup luksChangeKey "$device" -; then
        echo "✓ Passphrase changed."
        log_action "passphrase_changed device=$device"
    else
        die "Failed to change passphrase. Wrong current passphrase?"
    fi

    unset OLD_PASS NEW_PASS NEW_PASS_CONFIRM
}

# ── Command: info ─────────────────────────────────────────────────────────
cmd_info() {
    local device
    device="$(find_persist_part "${1:-}")"

    if [[ -z "$device" ]]; then
        echo "Persistence partition not found."
        return 1
    fi

    echo "=== Persistence Partition Info ==="
    echo "Device: $device"
    echo ""

    # blkid details
    echo "blkid:"
    blkid "$device" 2>/dev/null || true
    echo ""

    # lsblk tree
    echo "lsblk:"
    lsblk -o NAME,SIZE,FSTYPE,UUID,LABEL,MOUNTPOINT "$device" 2>/dev/null || true
    echo ""

    # LUKS info
    if blkid -s TYPE -o value "$device" 2>/dev/null | grep -qi luks; then
        echo "LUKS Info:"
        cryptsetup luksDump "$device" 2>/dev/null | head -20 || true
        echo ""
    fi

    # Filesystem info (if open)
    if [[ -e "/dev/mapper/${LUKS_MAPPER}" ]]; then
        echo "Filesystem Info:"
        tune2fs -l "/dev/mapper/${LUKS_MAPPER}" 2>/dev/null | grep -E 'Block count|Block size|Free blocks|Inode count' || true
        echo ""
        echo "Usage:"
        df -h "/dev/mapper/${LUKS_MAPPER}" 2>/dev/null || true
    fi
}

# ── Helpers for setup wizard ──────────────────────────────────────────────

# Derive the parent disk + partition number from a partition device path.
# Echoes "<disk> <partnum>" on success. Dies on unparseable input.
_parse_part_dev() {
    local part="$1"
    if [[ "$part" =~ ^/dev/(nvme[0-9]+n[0-9]+)p([0-9]+)$ ]]; then
        echo "/dev/${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    elif [[ "$part" =~ ^/dev/(mmcblk[0-9]+)p([0-9]+)$ ]]; then
        echo "/dev/${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    elif [[ "$part" =~ ^/dev/([a-z]+)([0-9]+)$ ]]; then
        echo "/dev/${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    else
        die "Cannot parse partition device: $part"
    fi
}

# Check that a device is safe to write to (not the boot device, not mounted,
# not a loop/ram device, meets minimum size). Echoes human-readable size info.
_validate_target_device() {
    local dev="$1" min_bytes="${2:-$((4 * 1024 * 1024 * 1024))}"

    [[ -b "$dev" ]] || die "Not a block device: $dev"

    # Refuse loop, ram, and zram devices.
    case "$dev" in
        /dev/loop*|/dev/ram*|/dev/zram*) die "Refusing to use virtual device: $dev" ;;
    esac

    # Refuse the running root/boot device.
    local root_dev
    root_dev="$(findmnt -n -o SOURCE / 2>/dev/null | sed -E 's/p?[0-9]+$//' || true)"
    if [[ -n "$root_dev" ]] && [[ "$dev" == "$root_dev" || "$dev" == "${root_dev}p"* ]]; then
        die "$dev is the running root device. Aborting."
    fi

    # Mounted check (whole-disk mode).
    if lsblk -n -o MOUNTPOINT "$dev" 2>/dev/null | grep -q .; then
        die "$dev has mounted partitions. Unmount all partitions first."
    fi

    local size_bytes
    size_bytes="$(lsblk -d -b -n -o SIZE "$dev" 2>/dev/null || echo 0)"
    [[ "$size_bytes" =~ ^[0-9]+$ ]] || size_bytes=0
    if [[ "$size_bytes" -lt "$min_bytes" ]]; then
        local min_gb cur_gb
        min_gb="$(awk -v b="$min_bytes" 'BEGIN{printf "%.1f", b/1073741824}')"
        cur_gb="$(awk -v b="$size_bytes" 'BEGIN{printf "%.1f", b/1073741824}')"
        die "Device too small (${cur_gb}GB). Minimum ${min_gb}GB required."
    fi
    echo "$size_bytes"
}

# Read a non-empty passphrase twice (confirmation) via stdin. Echoes the
# passphrase on stdout (prompts go to stderr so they don't contaminate the
# value when used in command substitution). Sensitive: caller must `unset`.
_read_passphrase_twice() {
    local p1="" p2=""
    echo -n "Enter new LUKS passphrase: " >&2
    read -rs p1; echo "" >&2
    [[ -n "$p1" ]] || { echo "Aborted: empty passphrase." >&2; return 1; }
    echo -n "Confirm passphrase: " >&2
    read -rs p2; echo "" >&2
    [[ "$p1" == "$p2" ]] || { echo "Aborted: passphrases do not match." >&2; return 1; }
    printf '%s' "$p1"
    unset p1 p2
}

# Format a partition as LUKS2 + ext4 labeled codex-persist. Args:
#   $1 partition device, $2 passphrase (read from stdin via fd 0)
_format_luks_persist() {
    local part="$1" pass
    pass="$(cat)"
    [[ -n "$pass" ]] || die "Empty passphrase passed to _format_luks_persist."
    printf '%s' "$pass" | cryptsetup luksFormat --type luks2 "$part" -q - \
        || die "cryptsetup luksFormat failed on $part"
    printf '%s' "$pass" | cryptsetup open "$part" "$LUKS_MAPPER" - \
        || die "cryptsetup open failed on $part"
    mkfs.ext4 -F -L codex-persist "/dev/mapper/${LUKS_MAPPER}" >/dev/null 2>&1 \
        || { cryptsetup close "$LUKS_MAPPER" 2>/dev/null || true; \
             die "mkfs.ext4 failed on mapper ${LUKS_MAPPER}"; }
    cryptsetup close "$LUKS_MAPPER" || die "cryptsetup close failed"
    unset pass
}

# ── Command: setup (guided wizard) ────────────────────────────────────────
# The guided persistence setup wizard. Creates and formats a persistence
# partition, either:
#   (a) on an EXISTING free partition of a target device (--partition), or
#   (b) by creating a NEW partition filling the remaining space on a whole
#       disk that already has CoLinux installed (--disk).
#
# Either mode ends with an unmounted, closed LUKS2+ext4 partition labeled
# `codex-persist`, ready to be opened/mounted by `codex-usb-persist mount`.
#
# Usage:
#   codex-usb-persist setup --disk /dev/sdX [--size N]
#   codex-usb-persist setup --partition /dev/sdXN
cmd_setup() {
    local target_disk="" target_part="" size_spec="max"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --disk) target_disk="${2:?--disk requires a device}"; shift 2 ;;
            --partition) target_part="${2:?--partition requires a device}"; shift 2 ;;
            --size) size_spec="${2:?--size requires a value (e.g. 4096 or max)}"; shift 2 ;;
            --help|-h) cat <<'EOF'
Usage: codex-usb-persist setup --disk DEVICE [--size N]
       codex-usb-persist setup --partition PARTITION

Guided wizard to create and format the CoLinux persistence partition.

Modes:
  --disk DEVICE       Create a new partition in the remaining free space of
                      DEVICE (a whole disk that already has CoLinux installed)
                      and format it as LUKS2 + ext4.
  --partition PART    Format an EXISTING partition PART as LUKS2 + ext4.
                      All data on PART will be destroyed.

Options:
  --size N            Partition size in MB (only with --disk). Use 'max' (the
                      default) to fill all remaining free space.
  --yes               Skip interactive confirmation (CI / scripted use).
  --json              Emit a structured JSON result envelope.
  --help, -h          Show this help.

Examples:
  codex-usb-persist setup --disk /dev/sdb
  codex-usb-persist setup --disk /dev/sdb --size 8192
  codex-usb-persist setup --partition /dev/sdb3
EOF
                return 0 ;;
            *) die "setup: unknown option '$1'. See 'codex-usb-persist setup --help'." ;;
        esac
    done

    # Exactly one of --disk / --partition must be given.
    if [[ -z "$target_disk" ]] && [[ -z "$target_part" ]]; then
        die "setup: --disk or --partition is required. See 'codex-usb-persist setup --help'."
    fi
    if [[ -n "$target_disk" ]] && [[ -n "$target_part" ]]; then
        die "setup: --disk and --partition are mutually exclusive."
    fi
    if [[ -n "$target_part" ]] && [[ "$size_spec" != "max" ]]; then
        die "setup: --size is only valid with --disk."
    fi

    command -v cryptsetup >/dev/null 2>&1 || die "cryptsetup not found. Install: apt install cryptsetup"
    command -v mkfs.ext4 >/dev/null 2>&1 || die "mkfs.ext4 not found. Install: apt install e2fsprogs"

    local part=""
    log_action "setup_start disk=${target_disk:-} part=${target_part:-} size=$size_spec"

    # ── Whole-disk mode: create a new partition ───────────────────────────
    if [[ -n "$target_disk" ]]; then
        command -v sgdisk >/dev/null 2>&1 || die "sgdisk not found. Install: apt install gdisk"

        _validate_target_device "$target_disk"

        echo "╔══════════════════════════════════════════════════════╗"
        echo "║       COLINUX USB PERSISTENCE WIZARD (DISK)         ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  Target disk: $target_disk"
        local model size_gb transport
        model="$(lsblk -d -n -o MODEL "$target_disk" 2>/dev/null | xargs || echo 'Unknown')"
        size_gb="$(lsblk -d -b -n -o SIZE "$target_disk" 2>/dev/null | awk '{printf "%.1f", $1/1073741824}')"
        transport="$(lsblk -d -n -o TRAN "$target_disk" 2>/dev/null | xargs || echo 'N/A')"
        echo "║  Model:       $model"
        echo "║  Size:        ${size_gb}GB"
        echo "║  Transport:   $transport"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  This will create a new partition and DESTROY all    ║"
        echo "║  data in the remaining free space of this disk.      ║"
        echo "╚══════════════════════════════════════════════════════╝"

        colinux_confirm "Type YES to continue:" "YES" \
            || die "Aborted by user."

        # Determine the new partition number (one past the last existing one).
        local last_part
        last_part="$(sgdisk -p "$target_disk" 2>/dev/null | awk '/^ +[0-9]+/ {n=$1} END{print n+0}')"
        local new_part_num=$((last_part + 1))
        [[ "$new_part_num" -ge 1 ]] || die "Could not determine next partition number on $target_disk"

        if [[ "$size_spec" == "max" ]]; then
            sgdisk -n "${new_part_num}:0:0" -t "${new_part_num}:8300" \
                   -c "${new_part_num}:CoLinuxPersistence" "$target_disk" >/dev/null 2>&1 \
                || die "sgdisk: failed to create partition ${new_part_num} on $target_disk"
        else
            # Validate numeric MB size.
            [[ "$size_spec" =~ ^[0-9]+$ ]] || die "--size must be a number of MB or 'max'."
            sgdisk -n "${new_part_num}:0:+${size_spec}M" -t "${new_part_num}:8300" \
                   -c "${new_part_num}:CoLinuxPersistence" "$target_disk" >/dev/null 2>&1 \
                || die "sgdisk: failed to create partition ${new_part_num} (size ${size_spec}M) on $target_disk"
        fi

        partprobe "$target_disk" 2>/dev/null || true
        sleep 2

        # Resolve the new partition device path.
        case "$target_disk" in
            /dev/nvme*|/dev/mmcblk*) part="${target_disk}p${new_part_num}" ;;
            *) part="${target_disk}${new_part_num}" ;;
        esac
        [[ -b "$part" ]] || die "Newly created partition $part is not visible. Run partprobe and retry."

    # ── Partition mode: format an existing partition ──────────────────────
    else
        part="$target_part"
        _validate_target_device "$part"

        echo "╔══════════════════════════════════════════════════════╗"
        echo "║    COLINUX USB PERSISTENCE WIZARD (PARTITION)       ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  Target partition: $part"
        echo "║  Existing filesystem: $(blkid -s TYPE -o value "$part" 2>/dev/null || echo 'none')"
        echo "║  Existing label:     $(blkid -s LABEL -o value "$part" 2>/dev/null || echo 'none')"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  This will DESTROY all data on this partition.       ║"
        echo "╚══════════════════════════════════════════════════════╝"

        colinux_confirm "Type YES to continue:" "YES" \
            || die "Aborted by user."
    fi

    # ── Format: LUKS2 + ext4 labeled codex-persist ────────────────────────
    echo ""
    echo "[1/3] Creating LUKS2 container on $part ..."
    echo "[2/3] Creating ext4 filesystem (label: codex-persist) ..."

    local pass
    pass="$(_read_passphrase_twice)" || die "Passphrase entry failed."
    printf '%s' "$pass" | _format_luks_persist "$part"
    unset pass

    # ── Verify the result ─────────────────────────────────────────────────
    echo "[3/3] Verifying ..."
    local fmt label
    fmt="$(blkid -s TYPE -o value "$part" 2>/dev/null || true)"
    label="$(blkid -s LABEL -o value "$part" 2>/dev/null || true)"
    [[ "$fmt" == "crypto_LUKS" ]] || die "Verification failed: $part is not LUKS ($fmt)."

    echo ""
    echo "✓ Persistence partition ready: $part"
    echo "  Format: LUKS2 + ext4"
    echo "  Label:  codex-persist"
    echo ""
    echo "To use it:"
    echo "  codex-usb-persist mount $part"
    log_action "setup_ok part=$part fmt=$fmt"

    colinux_result "persistence partition created" \
        "{\"partition\":\"$part\",\"format\":\"LUKS2+ext4\",\"label\":\"codex-persist\"}"
}

# ── Main dispatch ─────────────────────────────────────────────────────────
# Guarded so the script can be sourced by unit tests (functions only) without
# triggering dispatch. The snapshot/update-os wrappers use the same pattern.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
main_dispatch() {
    # `setup` takes its own flags (--disk/--partition/--size/--help), so route
    # it BEFORE stripping global flags; everything else uses positional args
    # after --json/--yes/-y are removed.
    colinux_init_output

    case "${1:-}" in
        setup|create|init|wizard)
            shift  # drop the subcommand name, pass remaining flags to cmd_setup
            cmd_setup "$@"
            exit $?
            ;;
    esac

    # Strip --json/--yes/-y from positional args (pre-scan already set
    # COLINUX_* vars); subcommands use positional $2/$3 directly.
    _filtered=()
    for _a in "$@"; do
        case "$_a" in --json|--yes|-y) ;; *) _filtered+=("$_a") ;; esac
    done
    set -- "${_filtered[@]}"
    COMMAND="${1:-}"

    case "${COMMAND:-}" in
        status|st|"")
            cmd_status "${2:-}"
            ;;
        open|unlock)
            cmd_open "${2:-}"
            ;;
        close|lock)
            cmd_close
            ;;
        mount)
            cmd_mount "${2:-}"
            ;;
        unmount|umount)
            cmd_unmount
            ;;
        resize)
            cmd_resize "${2:-}" "${3:-}"
            ;;
        passphrase|pass|chpass)
            cmd_passphrase "${2:-}"
            ;;
        info|details)
            cmd_info "${2:-}"
            ;;
        help|--help|-h)
            cat <<EOF
Usage: codex-usb-persist <COMMAND> [OPTIONS]

Commands:
  setup               Guided wizard — create & format the persistence partition
  status [DEVICE]     Show persistence status
  open [DEVICE]       Unlock LUKS persistence
  close               Lock LUKS persistence
  mount [DEVICE]      Open + mount at /persist
  unmount             Unmount + close persistence
  resize DEVICE SIZE  Resize persistence partition
  passphrase [DEVICE] Change LUKS passphrase
  info [DEVICE]       Detailed partition info

Run 'codex-usb-persist setup --help' for the wizard's own options.
If DEVICE is not specified, auto-detection is attempted.
EOF
            ;;
        *)
            die "Unknown command: ${COMMAND}. Run 'codex-usb-persist help' for usage."
            ;;
    esac
}
main_dispatch "$@"
fi
