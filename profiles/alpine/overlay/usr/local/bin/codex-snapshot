#!/bin/bash
# codex-snapshot — Create portable state snapshots with metadata
# Part of CoLinux Lite
#
# Usage:
#   codex-snapshot                          Create a timestamped snapshot
#   codex-snapshot --upload URL             Upload snapshot to remote URL
#   codex-snapshot --list                   List existing snapshots
#   codex-snapshot --restore <file>         Restore a snapshot
#   codex-snapshot --prune N                Keep only last N snapshots
set -euo pipefail


COLINUX_COMMAND="codex-snapshot"
[[ " $* " == *" --json "* ]] && COLINUX_JSON=true
# shellcheck source=/usr/local/lib/colinux/output.sh
if ! source /usr/local/lib/colinux/output.sh 2>/dev/null; then
    colinux_init_output() { :; }
    colinux_result() { :; }
    colinux_die() { echo "ERROR: $*" >&2; exit 1; }
    colinux_confirm() {
        [[ "${COLINUX_YES:-}" == "true" ]] && return 0
        local _r=""; read -rp "$1 " _r || _r=""; case "${_r,,}" in y|yes) return 0;; *) return 1;; esac
    }
fi

PERSIST_DIR="${COLINUX_PERSIST_DIR:-/persist}"
ETC_DIR="${COLINUX_ETC_DIR:-/etc}"
SNAPSHOT_DIR="${PERSIST_DIR}/snapshots"
LOG_DIR="${PERSIST_DIR}/logs"
LOGFILE="${LOG_DIR}/backup.log"

mkdir -p "$SNAPSHOT_DIR" "$LOG_DIR"

log_action() {
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S %Z')"
    echo "[$ts] snapshot: $*" >> "$LOGFILE"
}

die() {
    log_action "FATAL $*"
    colinux_die "$@"
}

# ── JSON helpers (no eval/source; safe even on BusyBox) ─────────────────────
# Read a top-level string key from a JSON file.
json_get() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    if command -v jq >/dev/null 2>&1; then
        jq -r --arg k "$key" '.[$k] // empty' "$file" 2>/dev/null
    else
        grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null \
            | sed -E "s/.*:[[:space:]]*\"([^\"]*)\".*/\1/" | head -1
    fi
}


validate_snapshot_archive() {
    local archive="$1"
    local entry

    tar tzf "$archive" >/dev/null 2>&1 || die "Failed to read snapshot archive."

    while IFS= read -r entry; do
        case "$entry" in
            ""|/*|../*|*/../*|*/..) die "Unsafe snapshot path: $entry" ;;
        esac
    done < <(tar tzf "$archive")

    if tar tvzf "$archive" 2>/dev/null | awk '$1 ~ /^[lh]/ { bad=1 } END { exit bad ? 0 : 1 }'; then
        die "Snapshot contains symlinks or hardlinks; refusing unsafe restore."
    fi
}

usage() {
    cat <<'EOF'
Usage: codex-snapshot [OPTIONS]

Create portable state snapshots with version metadata embedded.

Each snapshot is a tar.gz of /persist with a META.json at its root capturing
version info (edition, colinux_version, os_image_version, codex_cli_version,
alpine_release, hostname, kernel, arch, timestamp, etc.). A sibling
<snapshot>.meta.json is also written for backward compatibility.

Options:
  (no args)     Create a new snapshot
  --upload URL  Upload snapshot to remote URL (via curl PUT)
  --list        List existing snapshots with metadata
  --restore F   Restore from a snapshot file (shows source version + downgrade
                advisory before overwriting /persist)
  --prune N     Keep only the last N snapshots
  --json        Emit JSON result where applicable
  --yes         Skip interactive prompts (automation; also honors COLINUX_YES)
  --help        Show this help

Environment:
  COLINUX_PERSIST_DIR  Override /persist (testing / non-standard layouts)
  COLINUX_ETC_DIR      Override /etc (testing / non-standard layouts)
  COLINUX_YES=true     Equivalent to --yes

Examples:
  codex-snapshot
  codex-snapshot --upload https://example.com/backups/
  codex-snapshot --list
  codex-snapshot --restore colinux-codex-20260730-120000.tar.gz
  codex-snapshot --prune 5
EOF
    exit 0
}

# ── Parse args ────────────────────────────────────────────────────────────
MODE="create"
TARGET_URL=""
RESTORE_FILE=""
PRUNE_COUNT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --upload) MODE="upload"; TARGET_URL="${2:?--upload requires a URL}"; shift 2 ;;
        --list|list) MODE="list"; shift ;;
        --restore) MODE="restore"; RESTORE_FILE="${2:?--restore requires a file}"; shift 2 ;;
        --prune) MODE="prune"; PRUNE_COUNT="${2:?--prune requires a number}"; shift 2 ;;
        --json)
            COLINUX_JSON=true
            shift
            ;;
        --yes|-y)
            COLINUX_YES=true
            shift
            ;;
        --help|-h) usage ;;
        *) die "Unknown option: $1" ;;
    esac
done

colinux_init_output

# ── Gather metadata ───────────────────────────────────────────────────────
# Reads version info from multiple sources (best-effort, never fails):
#   - /etc/colinux-version          → human version string ("0.5.1")
#   - /etc/colinux-release.json     → {edition, version, codex_tag, ...}
#   - active A/B slot manifest.json → {version, alpine_release, arch, created}
#   - codex --version               → installed Codex CLI version
gather_metadata() {
    local hostname_val kernel_val arch_val timestamp_val
    hostname_val="$(hostname -s 2>/dev/null || echo 'codex')"
    kernel_val="$(uname -r 2>/dev/null || echo 'unknown')"
    arch_val="$(uname -m 2>/dev/null || echo 'unknown')"
    timestamp_val="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

    # Hardware ID — use first disk serial or machine-id
    local hw_id
    if [[ -f /etc/machine-id ]]; then
        hw_id="$(cat /etc/machine-id 2>/dev/null | cut -c1-12)"
    elif [[ -f /var/lib/dbus/machine-id ]]; then
        hw_id="$(cat /var/lib/dbus/machine-id 2>/dev/null | cut -c1-12)"
    else
        hw_id="$(ip link show 2>/dev/null | awk '/link\/ether/ {print $2; exit}' | head -1 | tr -d ':' || echo 'unknown')"
    fi

    # Disk info
    local boot_dev boot_size
    boot_dev="$(findmnt -n -o SOURCE / 2>/dev/null | head -1 || echo 'unknown')"
    if [[ -b "$boot_dev" ]] && command -v blockdev &>/dev/null; then
        boot_size="$(numfmt --to=iec --suffix=B "$(blockdev --getsize64 "$boot_dev" 2>/dev/null || echo 0)")"
    else
        boot_size="unknown"
    fi

    # Persist size
    local persist_size
    persist_size="$(du -sh "$PERSIST_DIR" 2>/dev/null | awk '{print $1}' || echo 'unknown')"

    # ── Version metadata (v0.5: rich, multi-source) ───────────────────────
    local release_json="${ETC_DIR}/colinux-release.json"
    local version_file="${ETC_DIR}/colinux-version"

    # Edition + appliance version
    local edition appliance_version codex_tag
    edition="$(json_get "$release_json" edition || echo 'lite')"
    appliance_version="$(cat "$version_file" 2>/dev/null || json_get "$release_json" version || echo 'dev')"
    codex_tag="$(json_get "$release_json" codex_tag || echo '')"

    # OS image version from active slot manifest (best-effort; may be absent on
    # non-A/B installs or in CI/test sandboxes).
    local os_image_version alpine_release_img
    os_image_version="$(current_os_version || echo 'unknown')"
    alpine_release_img="$(current_os_field alpine_release || echo '')"

    # Alpine release (running system) — /etc/alpine-release on Alpine.
    local alpine_release_running
    alpine_release_running="$(cat "${ETC_DIR}/alpine-release" 2>/dev/null || echo "$alpine_release_img" || echo 'unknown')"

    # Codex CLI version (best-effort)
    local codex_cli_version codex_bin
    codex_cli_version="unknown"
    for codex_bin in /usr/local/bin/codex /usr/bin/codex; do
        if [[ -x "$codex_bin" ]]; then
            codex_cli_version="$("$codex_bin" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo 'unknown')"
            break
        fi
    done

    jq -n \
        --arg hostname "$hostname_val" \
        --arg kernel "$kernel_val" \
        --arg arch "$arch_val" \
        --arg timestamp "$timestamp_val" \
        --arg hw_id "$hw_id" \
        --arg boot_device "$boot_dev" \
        --arg boot_size "$boot_size" \
        --arg persist_size "$persist_size" \
        --arg edition "$edition" \
        --arg colinux_version "$appliance_version" \
        --arg codex_cli_version "$codex_cli_version" \
        --arg codex_tag "$codex_tag" \
        --arg os_image_version "$os_image_version" \
        --arg alpine_release "$alpine_release_running" \
        --arg snapshot_format "1" \
        '{
            schema_version: ($snapshot_format|tonumber),
            timestamp: $timestamp,
            edition: $edition,
            colinux_version: $colinux_version,
            codex_cli_version: $codex_cli_version,
            codex_tag: $codex_tag,
            os_image_version: $os_image_version,
            alpine_release: $alpine_release,
            hostname: $hostname,
            kernel: $kernel,
            arch: $arch,
            hw_id: $hw_id,
            boot_device: $boot_device,
            boot_size: $boot_size,
            persist_size: $persist_size
        }'
}

# ── OS slot helpers (best-effort, read-only, never fatal) ───────────────────
# These mirror codex-update-os's lightweight approach but avoid any dependency
# on that command. They try (1) /persist/state/ab-slot + mounting the active
# slot's manifest.json, then (2) fall back to /etc/colinux-release.json.
current_os_version() { _current_os_field version; }
current_os_field()   { _current_os_field "$1"; }
_current_os_field() {
    local key="${1:-version}"
    local slot_file="${PERSIST_DIR}/state/ab-slot"
    local release_json="${ETC_DIR}/colinux-release.json"

    # Prefer the release.json baked at build time — it's always present on a
    # real install and reflects the currently booted image. The A/B slot
    # manifest is authoritative for an in-progress update, but that info is
    # also captured in release.json after a successful trial confirmation.
    local v
    if v="$(json_get "$release_json" "$key" 2>/dev/null)" && [[ -n "$v" ]]; then
        echo "$v"
        return 0
    fi

    # Fall back to reading the active slot manifest (best-effort mount).
    if [[ -f "$slot_file" ]] && command -v mount >/dev/null 2>&1; then
        local slot dev mnt manifest
        slot="$(cat "$slot_file" 2>/dev/null | tr -d '[:space:]')"
        [[ -n "$slot" ]] || return 1
        dev="$(_slot_device_for "$slot")"
        [[ -n "$dev" && -b "$dev" ]] || return 1
        mnt="$(mktemp -d 2>/dev/null)" || return 1
        if mount -o ro "$dev" "$mnt" 2>/dev/null; then
            manifest="$mnt/manifest.json"
            v="$(json_get "$manifest" "$key" 2>/dev/null || true)"
            umount "$mnt" 2>/dev/null || true
        fi
        rmdir "$mnt" 2>/dev/null || true
        if [[ -n "$v" ]]; then
            echo "$v"
            return 0
        fi
    fi
    return 1
}

# Map an A/B slot label ("A"/"B") to its block device, using blkid labels.
# Pure discovery — no writes. Returns empty string when not found.
_slot_device_for() {
    local slot="$1"
    local label
    case "$slot" in
        A) label="codex-system-a" ;;
        B) label="codex-system-b" ;;
        *) return 0 ;;
    esac
    if command -v blkid >/dev/null 2>&1; then
        blkid -t "LABEL=$label" -o device 2>/dev/null | head -1
    elif [[ -x /sbin/findfs ]]; then
        /sbin/findfs "LABEL=$label" 2>/dev/null | head -1
    fi
}

# ── Embedded-metadata reader ───────────────────────────────────────────────
# Extract META.json from a snapshot tarball to a temp file and echo its path.
# Returns non-zero (and echoes nothing) when no embedded META is present.
# Extraction is limited to the single META.json member so we never touch the
# rest of the payload here.
#
# The member may be stored as either ./META.json (when appended from a
# -C dir that preserved the ./ prefix) or META.json (when appended without
# the prefix). We try both patterns individually because passing both to a
# single tar invocation makes tar exit non-zero if either is absent, which
# would mask a successful extraction of the other.
extract_embedded_meta() {
    local archive="$1" tmp
    tmp="$(mktemp)"
    local ok=1
    for pat in ./META.json META.json; do
        if tar xzf "$archive" -O "$pat" 2>/dev/null > "$tmp" \
           && [[ -s "$tmp" ]] \
           && jq -e . >/dev/null 2>&1 < "$tmp"; then
            ok=0
            break
        fi
    done
    if [[ "$ok" -eq 0 ]]; then
        echo "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Print a single metadata field for a snapshot, preferring the embedded META
# over the sibling .meta.json. Usage: meta_field <snapshot_path> <key>
meta_field() {
    local snap="$1" key="$2" embedded sibling
    if embedded="$(extract_embedded_meta "$snap")"; then
        jq -r --arg k "$key" '.[$k] // empty' "$embedded" 2>/dev/null
        rm -f "$embedded"
        return 0
    fi
    sibling="${snap}.meta.json"
    [[ -f "$sibling" ]] && jq -r --arg k "$key" '.[$k] // empty' "$sibling" 2>/dev/null
}

# ── Create snapshot ───────────────────────────────────────────────────────
if [[ "$MODE" == "create" ]]; then
    TIMESTAMP="$(date -u '+%Y%m%d-%H%M%S')"
    HOSTNAME="$(hostname -s 2>/dev/null || echo 'codex')"
    SNAP_NAME="colinux-${HOSTNAME}-${TIMESTAMP}.tar.gz"
    SNAP_PATH="${SNAPSHOT_DIR}/${SNAP_NAME}"

    echo "Creating CoLinux state snapshot..."
    echo "  Output: ${SNAP_NAME}"

    # Generate metadata
    META_JSON="$(gather_metadata)"
    META_STAGE="$(mktemp -d)"
    _cleanup_meta() { rm -rf "$META_STAGE" 2>/dev/null || true; }
    trap _cleanup_meta EXIT
    echo "$META_JSON" > "${META_STAGE}/META.json"

    log_action "create_start snapshot=${SNAP_NAME}"

    # Build the archive with META.json embedded at ./META.json (root of the
    # tarball), so the snapshot is self-describing and survives copy/upload
    # without its sibling .meta.json. The payload is the /persist tree with
    # snapshots/backups excluded to avoid recursion.
    #
    # Two-step (tar then gzip) so we can append META.json portably. BusyBox
    # tar supports -r (append); GNU tar does too. If append fails for any
    # reason we fall back to the single-step tar-from-/persist and ship META
    # only as the sibling file (legacy behaviour).
    SNAP_UNCOMPRESSED="${SNAP_PATH%.tar.gz}.tar"
    _cleanup_uncompressed() { rm -f "$SNAP_UNCOMPRESSED" 2>/dev/null || true; }
    trap '_cleanup_meta; _cleanup_uncompressed' EXIT

    if tar cf "$SNAP_UNCOMPRESSED" \
            --exclude='*.sock' \
            --exclude='*.pid' \
            --exclude='__pycache__' \
            --exclude='.cache' \
            --exclude='snapshots/*.tar.gz' \
            --exclude='snapshots/*.tar' \
            --exclude='backups/*.tar.gz' \
            -C "$PERSIST_DIR" \
            . 2>&1 \
       && tar rf "$SNAP_UNCOMPRESSED" -C "$META_STAGE" META.json 2>&1; then
        gzip -f "$SNAP_UNCOMPRESSED"
    else
        # Fallback: legacy single-step archive without embedded META.
        rm -f "$SNAP_UNCOMPRESSED"
        tar czf "$SNAP_PATH" \
            --exclude='*.sock' \
            --exclude='*.pid' \
            --exclude='__pycache__' \
            --exclude='.cache' \
            --exclude='snapshots/*.tar.gz' \
            --exclude='backups/*.tar.gz' \
            -C "$PERSIST_DIR" \
            . 2>&1
    fi

    # Also write metadata as sibling file (back-compat with older --list).
    cp "${META_STAGE}/META.json" "${SNAP_PATH}.meta.json"

    SNAP_SIZE="$(du -sh "$SNAP_PATH" | awk '{print $1}')"
    echo ""
    echo "Snapshot created:"
    echo "  File:     ${SNAP_NAME} ($SNAP_SIZE)"
    echo "  Metadata: embedded (META.json) + sibling (.meta.json)"
    echo ""
    echo "Metadata:"
    echo "$META_JSON" | jq '.' 2>/dev/null || echo "$META_JSON"
    echo ""

    log_action "create_ok snapshot=${SNAP_NAME} size=$SNAP_SIZE"
fi

# ── Upload snapshot ───────────────────────────────────────────────────────
if [[ "$MODE" == "upload" ]]; then
    # Find latest snapshot
    LATEST="$(ls -1t "${SNAPSHOT_DIR}"/*.tar.gz 2>/dev/null | head -1 || true)"
    if [[ -z "$LATEST" ]]; then
        die "No snapshots found. Create one first: codex-snapshot"
    fi

    SNAP_NAME="${LATEST##*/}"
    echo "Uploading ${SNAP_NAME} to ${TARGET_URL}..."
    log_action "upload_start snapshot=${SNAP_NAME} url=$TARGET_URL"

    HTTP_CODE="$(curl -w '%{http_code}' -o /dev/null -T "$LATEST" "${TARGET_URL}${SNAP_NAME}" 2>/dev/null)"

    if [[ "$HTTP_CODE" -ge 200 ]] && [[ "$HTTP_CODE" -lt 300 ]]; then
        echo "Uploaded successfully (HTTP ${HTTP_CODE})"
        log_action "upload_ok snapshot=${SNAP_NAME} url=$TARGET_URL http=$HTTP_CODE"
    else
        die "Upload failed (HTTP ${HTTP_CODE})"
    fi
fi

# ── List snapshots ────────────────────────────────────────────────────────
if [[ "$MODE" == "list" ]]; then
    echo "=== CoLinux Snapshots ==="
    echo "Location: $SNAPSHOT_DIR"
    echo ""

    count=0
    for snap in "${SNAPSHOT_DIR}"/*.tar.gz; do
        [[ -f "$snap" ]] || continue
        count=$((count + 1))
        snap_name="${snap##*/}"
        snap_size="$(du -sh "$snap" | awk '{print $1}')"
        snap_date="$(stat -c '%y' "$snap" 2>/dev/null | cut -d. -f1)"

        # Read metadata (embedded META preferred over sibling .meta.json).
        meta_host="$(meta_field "$snap" hostname || echo '?')"
        meta_hw="$(meta_field "$snap" hw_id || echo '?')"
        meta_kernel="$(meta_field "$snap" kernel || echo '?')"
        meta_edition="$(meta_field "$snap" edition || echo '')"
        meta_colinux="$(meta_field "$snap" colinux_version || echo '')"
        meta_codex="$(meta_field "$snap" codex_cli_version || echo '')"
        meta_os="$(meta_field "$snap" os_image_version || echo '')"
        meta_ts="$(meta_field "$snap" timestamp || echo '')"

        echo "  $snap_name  ($snap_size)  $snap_date"
        echo "    Host: ${meta_host} | HW: ${meta_hw} | Kernel: ${meta_kernel}"
        # Version line (v0.5): edition, appliance version, OS image, Codex CLI
        _vline=""
        [[ -n "$meta_edition" ]] && _vline+="${meta_edition}/"
        [[ -n "$meta_colinux" ]] && _vline+="colinux-${meta_colinux}"
        [[ -n "$meta_os" && "$meta_os" != "unknown" ]] && _vline+=" os=${meta_os}"
        [[ -n "$meta_codex" && "$meta_codex" != "unknown" ]] && _vline+=" codex=${meta_codex}"
        [[ -n "$_vline" ]] && echo "    Version: ${_vline}"
        [[ -n "$meta_ts" ]] && echo "    Created: ${meta_ts}"
    done

    if [[ $count -eq 0 ]]; then
        echo "  (no snapshots found)"
    else
        echo ""
        echo "Total: $count snapshot(s)"
        echo "Size:  $(du -sh "$SNAPSHOT_DIR" 2>/dev/null | awk '{print $1}')"
    fi
fi

# ── Restore snapshot ──────────────────────────────────────────────────────
if [[ "$MODE" == "restore" ]]; then
    if [[ ! -f "$RESTORE_FILE" ]]; then
        # Try in snapshot dir
        if [[ -f "${SNAPSHOT_DIR}/${RESTORE_FILE}" ]]; then
            RESTORE_FILE="${SNAPSHOT_DIR}/${RESTORE_FILE}"
        else
            die "Snapshot not found: $RESTORE_FILE"
        fi
    fi

    # Resolve and validate path — prevent traversal (P0-4)
    RESTORE_FILE="$(realpath --relative-to="$SNAPSHOT_DIR" "$RESTORE_FILE" 2>/dev/null || echo "$RESTORE_FILE")"
    case "$RESTORE_FILE" in
        ../*|/*) die "Invalid snapshot path: $RESTORE_FILE" ;;
    esac
    RESTORE_FILE="${SNAPSHOT_DIR}/${RESTORE_FILE}"

    echo "=== RESTORE WARNING ==="
    echo "This will overwrite /persist with the snapshot contents."
    echo "  Source: $RESTORE_FILE"
    echo ""

    # Show source version metadata (v0.5) before prompting.
    SRC_META="$(extract_embedded_meta "$RESTORE_FILE" || true)"
    if [[ -n "$SRC_META" ]]; then
        src_edition="$(json_get "$SRC_META" edition || echo '')"
        src_colinux="$(json_get "$SRC_META" colinux_version || echo '')"
        src_os="$(json_get "$SRC_META" os_image_version || echo '')"
        src_codex="$(json_get "$SRC_META" codex_cli_version || echo '')"
        src_alpine="$(json_get "$SRC_META" alpine_release || echo '')"
        src_host="$(json_get "$SRC_META" hostname || echo '')"
        src_ts="$(json_get "$SRC_META" timestamp || echo '')"
        echo "  Snapshot version:"
        [[ -n "$src_edition" ]]  && echo "    Edition:    ${src_edition}"
        [[ -n "$src_colinux" ]]  && echo "    CoLinux:    ${src_colinux}"
        [[ -n "$src_os" && "$src_os" != "unknown" ]] && echo "    OS image:   ${src_os}"
        [[ -n "$src_codex" && "$src_codex" != "unknown" ]] && echo "    Codex CLI:  ${src_codex}"
        [[ -n "$src_alpine" && "$src_alpine" != "unknown" ]] && echo "    Alpine:     ${src_alpine}"
        [[ -n "$src_host" ]]     && echo "    Origin:     ${src_host}"
        [[ -n "$src_ts" ]]       && echo "    Captured:   ${src_ts}"
        echo ""

        # Non-blocking downgrade advisory — compare to running appliance version.
        cur_colinux="$(cat "${ETC_DIR}/colinux-version" 2>/dev/null || json_get "${ETC_DIR}/colinux-release.json" version || echo '')"
        if [[ -n "$cur_colinux" && -n "$src_colinux" \
              && "$cur_colinux" != "$src_colinux" \
              && "$cur_colinux" != "dev" && "$src_colinux" != "dev" ]]; then
            echo "  ⚠ Version mismatch: snapshot is CoLinux ${src_colinux}, this host runs ${cur_colinux}."
            echo "    Restoring an older snapshot is a DOWNGRADE and may be incompatible."
            echo "    Review codex_cli_version / os_image_version above before continuing."
            echo ""
        fi
    else
        echo "  (No embedded version metadata; legacy snapshot.)"
        echo ""
    fi

    if [[ "${COLINUX_YES:-}" != "true" ]]; then
        read -rp "Type 'RESTORE' to confirm: " confirm
        if [[ "$confirm" != "RESTORE" ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    log_action "restore_start source=$RESTORE_FILE"

    # Validate before extraction, then extract snapshot
    validate_snapshot_archive "$RESTORE_FILE"
    RESTORE_TMP="$(mktemp -d /tmp/colinux-restore.XXXXXX)"
    tar xzf "$RESTORE_FILE" -C "$RESTORE_TMP" 2>&1

    # Copy all restored files directly
    if [[ -n "$(ls -A "$RESTORE_TMP" 2>/dev/null)" ]]; then
        cp -a "$RESTORE_TMP"/. "$PERSIST_DIR/" 2>&1
        rm -rf "$RESTORE_TMP"
        rm -f "$SRC_META" 2>/dev/null || true
    else
        rm -rf "$RESTORE_TMP"
        rm -f "$SRC_META" 2>/dev/null || true
        die "Failed to extract snapshot."
    fi

    echo "Snapshot restored to ${PERSIST_DIR}"
    echo "Reboot recommended for full effect."
    log_action "restore_ok source=$RESTORE_FILE"
fi

# ── Prune ─────────────────────────────────────────────────────────────────
if [[ "$MODE" == "prune" ]]; then
    total="$(ls -1 "${SNAPSHOT_DIR}"/*.tar.gz 2>/dev/null | wc -l | tr -d ' ')"
    if [[ "$total" -gt "$PRUNE_COUNT" ]]; then
        delete_count=$((total - PRUNE_COUNT))
        echo "Pruning: keeping last $PRUNE_COUNT, deleting $delete_count..."
        ls -1t "${SNAPSHOT_DIR}"/*.tar.gz | tail -n "$delete_count" | while read -r old_snap; do
            echo "  Deleting: ${old_snap##*/}"
            rm -f "$old_snap" "${old_snap}.meta.json"
        done
        log_action "prune kept=$PRUNE_COUNT deleted=$delete_count"
    else
        echo "Nothing to prune ($total snapshot(s) exist)."
    fi
fi
