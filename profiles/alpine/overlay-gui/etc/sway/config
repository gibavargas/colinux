# CoLinux Lite GUI — Sway Configuration
# Minimal sway config: borderless fullscreen terminal running codex-shell-gui
# This is used as a fallback compositor if cage is not available.

# =============================================================================
# Input
# =============================================================================
input * {
    xkb_layout us
    xkb_variant ""
    xkb_options ""
}

# Tablets / touch devices: tap-to-click and natural scrolling on touchpads.
# Touchscreens are handled natively by libinput (single-touch = tap, drag).
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# =============================================================================
# Output — use all connected displays
# =============================================================================
output * {
    bg #1a1b26 solid_color
}

# =============================================================================
# Global keybindings (minimal)
# =============================================================================
set $mod Mod4

bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit CoLinux GUI?' -b 'Yes' 'swaymsg exit'
bindsym $mod+Shift+Escape exec killall foot || killall sway
bindsym Print exec "mkdir -p /persist/logs && grim /persist/logs/screenshot-$(date +%Y%m%d-%H%M%S).png"

# On-screen keyboard toggle (tablets/touch devices)
bindsym $mod+Space exec "codex-osk toggle 2>/dev/null || true"

# Apply persisted display resolution on compositor start (codex-display auto)
exec --no-startup-id codex-display apply 2>/dev/null || true

# =============================================================================
# Appearance — no borders, no gaps, no title bar
# =============================================================================
default_border none
default_floating_border none
hide_edge_borders both
gaps outer 0
gaps inner 0
font DejaVu Sans Mono 11

# =============================================================================
# Autostart — fullscreen foot terminal running codex-shell-gui
# =============================================================================
exec --no-startup-id foot --fullscreen -- /usr/local/bin/codex-shell-gui

# =============================================================================
# Window rules
# =============================================================================
for_window [app_id="foot"] {
    border none
    gaps outer 0
    gaps inner 0
}
